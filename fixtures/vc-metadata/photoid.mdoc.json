{
  "$comment": "EWC RFC013 Photo ID (ISO/IEC TS 23220-4 Annex C) as mso_mdoc. The optional org.iso.23220.dtc.1 namespace (raw eMRTD DG1/DG2/SOD) is deliberately not declared: facetec-api never releases raw chip data. photoid_card.svg is the readable source of the svg_templates data URI. The portrait is deliberately not on the card: the wallet shows it among the claims on the detail page.",
  "format": "mso_mdoc",
  "doctype": "eu.europa.ec.eudi.photoid.1",
  "display": [
    {
      "locale": "en-US",
      "name": "Photo ID",
      "description": "Photo ID derived from an electronic travel document (EWC RFC013)",
      "background_color": "#1a365d",
      "text_color": "#ffffff",
      "rendering": {
        "svg_templates": [
          {
            "uri": "data:image/svg+xml;base64,",
            "properties": {
              "orientation": "landscape"
            }
          }
        ]
      }
    }
  ],
  "claims": {
    "org.iso.23220.1": {
      "family_name_unicode": {
        "mandatory": true,
        "value_type": "tstr",
        "svg_id": "family_name",
        "display": [
          {
            "locale": "en-US",
            "name": "Family name"
          }
        ]
      },
      "given_name_unicode": {
        "mandatory": true,
        "value_type": "tstr",
        "svg_id": "given_name",
        "display": [
          {
            "locale": "en-US",
            "name": "Given names"
          }
        ]
      },
      "birth_date": {
        "mandatory": true,
        "value_type": "full-date",
        "svg_id": "birth_date",
        "display": [
          {
            "locale": "en-US",
            "name": "Date of birth"
          }
        ]
      },
      "portrait": {
        "mandatory": true,
        "value_type": "bstr",
        "description": "Portrait image of the holder, JPEG.",
        "display": [
          {
            "locale": "en-US",
            "name": "Portrait"
          }
        ]
      },
      "issue_date": {
        "mandatory": true,
        "value_type": "full-date",
        "display": [
          {
            "locale": "en-US",
            "name": "Date of issue"
          }
        ]
