{
  "format": "mso_mdoc",
  "doctype": "eu.europa.ec.eudi.pid.1",
  "display": [
    {
      "locale": "en-US",
      "name": "PID (mdoc) with identifiers",
      "description": "Person Identification Data (mdoc) carrying the birth date and the national identifier, the credential nym_auth is issued from; pid_mdoc stays the 4-claim Vega ZK test credential",
      "background_color": "#003399",
      "text_color": "#ffffff"
    }
  ],
  "claims": {
    "eu.europa.ec.eudi.pid.1": {
      "family_name": {
        "mandatory": true,
        "value_type": "tstr"
      },
      "given_name": {
        "mandatory": true,
        "value_type": "tstr"
      },
      "birth_date": {
        "mandatory": true,
        "value_type": "full-date"
      },
      "issuing_country": {
        "mandatory": true,
        "value_type": "tstr"
      },
      "administrative_number": {
        "mandatory": true,
        "value_type": "tstr"
      },
      "age_over_18": {
        "value_type": "bool"
      }
    }
  }
}
